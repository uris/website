# You'll need to have a way to get a key for using open AI realtime api
PRIVATE_API_BASE_URL=http://localhost:3001

# Public PostHog project token and ingestion host from your project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Analytics is off unless explicitly enabled and both values above are present.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Additional opt-in for npm run dev / other non-production builds.
NEXT_PUBLIC_ANALYTICS_DEV_ENABLED=false
