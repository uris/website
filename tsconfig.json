{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@/src/*": ["./src/*"],
			"@/features/*": ["./src/features/*"],
			"@/assets/*": ["./src/assets/*"],
			"@/utils/*": ["./src/utils/*"],
			"@/projects/*": ["./src/projects/*"],
			"@/skills/*": ["./src/skills/*"],
			"@/data/*": ["./src/data/*"],
			"@/stores/*": ["./src/stores/*"],
			"@/components/*": ["./src/components/*"],
			"@/landing/*": ["./src/landing/*"],
			"@/content/*": ["./src/content/*"]
		},
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
